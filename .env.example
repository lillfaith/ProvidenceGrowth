# Copy to .env.local (local dev) or set in your host's dashboard (Vercel, Netlify, ...).
# Every variable is optional. With none set, the site works and the form runs in demo mode.

# Public URL of the deployed site — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Lead form -------------------------------------------------------------------
# Which backend receives audit requests: webhook | formspree | supabase | demo
#   webhook   - POSTs JSON to NEXT_PUBLIC_LEAD_ENDPOINT. Use for Zapier, Make, n8n,
#               a CRM inbound webhook (HubSpot, GoHighLevel, Pipedrive...), or your own API.
#   formspree - POSTs to your Formspree form URL; Formspree emails you each lead.
#   supabase  - inserts a row into a `leads` table through the Supabase REST API.
#   demo      - logs to the console and shows the success state. Never use in production.
NEXT_PUBLIC_LEAD_PROVIDER=demo

# webhook: the full URL.  formspree: https://formspree.io/f/<your-form-id>
NEXT_PUBLIC_LEAD_ENDPOINT=

# supabase only (anon key is public by design; protect the table with RLS — see README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_LEADS_TABLE=leads

# ---- Analytics (scripts load only when an id is set) ------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
